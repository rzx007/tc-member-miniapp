.members-page { padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); }
.hero-banner { position: relative; height: 286rpx; overflow: hidden; margin: -50rpx -54rpx 58rpx; background: #111; color: #fff; }
.hero-image { position: absolute; top: -12rpx; right: -2rpx; bottom: -12rpx; left: -2rpx; width: calc(100% + 4rpx); height: calc(100% + 24rpx); filter: grayscale(1) contrast(1.06); transform: scale(1.025); }
.hero-glass { position: absolute; top: 0; right: 0; bottom: 0; left: 0; border: 1rpx solid rgba(255,255,255,.16); background: rgba(12,12,12,.18); -webkit-backdrop-filter: blur(13rpx) saturate(.72); backdrop-filter: blur(13rpx) saturate(.72); }
.hero-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(90deg, rgba(5,5,5,.88) 0%, rgba(5,5,5,.66) 38%, rgba(5,5,5,.2) 78%, rgba(5,5,5,.32) 100%); }
.hero-content { position: absolute; z-index: 2; top: 48rpx; right: 46rpx; bottom: 38rpx; left: 46rpx; display: flex; flex-direction: column; justify-content: space-between; }
.hero-brand { display: flex; align-items: flex-end; gap: 24rpx; }
.hero-mark { font-family: "Times New Roman", serif; font-size: 86rpx; line-height: .85; letter-spacing: -4rpx; }
.hero-en { white-space: pre-line; font-size: 16rpx; line-height: 1.35; letter-spacing: 2rpx; }
.hero-copy { font-family: "Songti SC", "SimSun", serif; font-size: 29rpx; letter-spacing: 6rpx; }
.staff-badge { position: absolute; z-index: 3; top: 24rpx; right: 28rpx; padding: 8rpx 16rpx; border: 1rpx solid rgba(255,255,255,.26); border-radius: 24rpx; background: rgba(0,0,0,.28); color: rgba(255,255,255,.9); font-size: 18rpx; -webkit-backdrop-filter: blur(12rpx); backdrop-filter: blur(12rpx); }
.heading-row { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) 176rpx; align-items: center; column-gap: 32rpx; margin: 0 0 54rpx; }
.heading-row .page-title { display: block; min-width: 0; }
.add-button { width: 176rpx; height: 88rpx; justify-self: end; display: flex; align-items: center; justify-content: center; border-radius: 46rpx; background: #171717; color: #fff; font-size: 27rpx; font-weight: 500; white-space: nowrap; transition: transform .18s ease-out, opacity .18s ease-out; }
.add-button-pressed { opacity: .82; transform: scale(.97); }
.plus { margin-right: 10rpx; font-size: 32rpx; font-weight: 300; }
.summary { padding-bottom: 44rpx; border-bottom: 1rpx solid #ddd; }
.summary-meta { display: flex; justify-content: space-between; margin-bottom: 38rpx; color: #666; font-size: 22rpx; }
.stats { display: grid; grid-template-columns: .7fr 1.2fr 1fr; gap: 20rpx; }
.stat { min-width: 0; display: flex; flex-direction: column; }
.stat-label { margin-bottom: 18rpx; color: #666; font-size: 23rpx; white-space: nowrap; }
.stat-value { font-family: "Times New Roman", serif; font-size: 42rpx; line-height: 1.2; letter-spacing: -1rpx; }
.stat-value.count { font-size: 48rpx; }
.search-box { position: relative; display: flex; align-items: center; margin: 58rpx 0 48rpx; min-height: 104rpx; padding: 0 76rpx 0 82rpx; border-radius: 55rpx; background: #f1f1f1; }
.search-box input { width: 100%; font-size: 25rpx; }
.search-icon { position: absolute; left: 34rpx; top: 25rpx; color: #555; font-size: 39rpx; transform: rotate(-20deg); }
.clear-button { position: absolute; right: 16rpx; width: 72rpx; min-height: 72rpx; color: #666; font-size: 30rpx; }
.list-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; color: #666; font-size: 23rpx; }
.level-picker { min-height: 76rpx; display: flex; align-items: center; padding-right: 30rpx; }
.member-row { width: 100%; min-height: 168rpx; display: grid; grid-template-columns: minmax(0, 1fr) auto 32rpx; align-items: center; column-gap: 20rpx; padding: 32rpx 0; text-align: left; border-radius: 20rpx; transition: background-color .18s ease-out, transform .18s ease-out; }
.member-row-pressed { background: #f2f2f2; transform: scale(.99); }
.member-main { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.member-name { font-family: "Songti SC", "SimSun", serif; font-size: 37rpx; letter-spacing: 2rpx; }
.phone { margin-top: 12rpx; color: #666; font-size: 23rpx; letter-spacing: 2rpx; }
.member-balance { font-family: "Times New Roman", serif; font-size: 40rpx; letter-spacing: -1rpx; }
.arrow { color: #aaa; font-size: 38rpx; font-weight: 200; text-align: right; }
