.optional-toggle { width: 100%; min-height: 108rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 38rpx; border-bottom: 1rpx solid #ddd; text-align: left; font-size: 25rpx; }
.toggle-icon { font-size: 39rpx; font-weight: 200; transition: transform .2s ease-out; }
.toggle-icon.open { transform: rotate(45deg); }
.optional-content { animation: reveal .22s ease-out; }
.footer-hint { display: block; margin-top: 50rpx; color: #737373; font-size: 23rpx; line-height: 1.8; }
@keyframes reveal { from { opacity: .55; transform: translateY(-8rpx); } to { opacity: 1; transform: none; } }
