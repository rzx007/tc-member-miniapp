<view class="page-shell">
  <text class="page-title">新增会员</text><text class="page-subtitle">从一次相遇，成为熟客。</text>
  <view class="form-field"><text class="field-label">姓名</text><input class="line-input" value="{{name}}" bindinput="onNameInput" maxlength="20" placeholder="姓名或称呼"></input></view>
  <view class="form-field"><text class="field-label">手机号</text><input class="line-input" value="{{phone}}" bindinput="onPhoneInput" type="number" maxlength="11" placeholder="11 位手机号"></input></view>
  <button class="optional-toggle" bindtap="toggleOptional"><text>等级与备注 <text class="field-hint">选填</text></text><text class="toggle-icon {{showOptional ? 'open' : ''}}">＋</text></button>
  <view wx:if="{{showOptional}}" class="optional-content">
    <view class="form-field"><text class="field-label">会员等级</text><picker range="{{levels}}" value="{{levelIndex}}" bindchange="onLevelChange"><view class="line-picker"><text>{{levels[levelIndex]}}</text><text>⌄</text></view></picker></view>
    <view class="form-field"><text class="field-label">备注</text><textarea class="line-textarea" value="{{remark}}" bindinput="onRemarkInput" maxlength="200" placeholder="偏好的妆感、色系或服务习惯"></textarea></view>
  </view>
  <text wx:if="{{error}}" class="error-message">{{error}}</text><text class="footer-hint">初始余额与积分为 0，保存后可登记充值。</text>
  <view class="bottom-dock"><button class="primary-button" disabled="{{saving}}" loading="{{saving}}" bindtap="save">{{saving ? '保存中' : '保存会员 ›'}}</button></view>
</view>
