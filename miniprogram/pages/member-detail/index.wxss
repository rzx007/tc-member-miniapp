.detail-page { padding-top: 28rpx; }
.member-card { position: relative; overflow: hidden; min-height: 358rpx; padding: 38rpx 42rpx 34rpx; border-radius: 30rpx 30rpx 84rpx 30rpx; color: #222; background: #f1f1f1; }
.card-top, .card-footer { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }
.card-signature { display: flex; align-items: center; min-width: 0; }
.card-logo { font-family: "Times New Roman", serif; font-size: 48rpx; line-height: 1; letter-spacing: -2rpx; }
.card-brand { margin-left: 18rpx; font-size: 15rpx; letter-spacing: 2rpx; }
.card-tier { flex-shrink: 0; margin-left: 16rpx; font-size: 22rpx; letter-spacing: 3rpx; }
.card-main { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin: 44rpx 0 36rpx; }
.card-identity { flex: 1 1 43%; min-width: 0; margin-right: 28rpx; }
.card-account { flex: 1 1 57%; min-width: 0; text-align: right; }
.card-name { display: block; font-family: "Songti SC", "SimSun", serif; font-size: 48rpx; line-height: 1.4; letter-spacing: 2rpx; word-break: break-all; }
.card-phone { display: block; margin-top: 8rpx; font-size: 22rpx; letter-spacing: 1rpx; color: #555; white-space: nowrap; }
.card-label { position: relative; z-index: 1; display: block; font-size: 21rpx; color: #555; }
.card-amount { position: relative; z-index: 1; display: block; margin: 8rpx 0 0; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; font-size: 58rpx; line-height: 1.25; font-weight: 400; letter-spacing: -2rpx; white-space: nowrap; font-variant-numeric: tabular-nums; }
.card-footer { border-top: 1rpx solid rgba(0,0,0,.13); padding-top: 23rpx; font-size: 21rpx; color: #555; }
.card-points { display: flex; align-items: center; }
.points-value { margin-left: 14rpx; color: #222; }
.card-number { margin-left: 16rpx; margin-right: 8rpx; font-size: 20rpx; letter-spacing: 1rpx; }
.curve { position: absolute; z-index: 0; pointer-events: none; right: -220rpx; bottom: -235rpx; width: 390rpx; height: 480rpx; border: 1rpx solid rgba(0,0,0,.1); border-radius: 50%; transform: rotate(30deg); }
.card-curve-two { right: -194rpx; bottom: -225rpx; width: 360rpx; height: 450rpx; }
.card-classic { background: #f0f0f0; box-shadow: inset 0 0 0 1rpx #dedede; }
.card-classic .card-curve-two { display: none; }
.card-silver { background: linear-gradient(122deg, #dadbdd 0%, #f6f6f7 36%, #dedfe1 66%, #c7c9cc 100%); box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.9); }
.card-silver .card-tier { padding: 6rpx 13rpx; border: 1rpx solid rgba(0,0,0,.2); border-radius: 18rpx; }
.card-gold { color: #f8f8f8; background: linear-gradient(125deg, #303030 0%, #171717 46%, #101010 100%); }
.card-gold .card-phone, .card-gold .card-label, .card-gold .card-footer { color: #c7c7c7; }
.card-gold .points-value { color: #fff; }
.card-gold .card-footer { border-color: rgba(255,255,255,.2); }
.card-gold .card-tier { padding: 6rpx 13rpx; border: 1rpx solid rgba(255,255,255,.45); border-radius: 18rpx; }
.card-gold .curve { border-color: rgba(255,255,255,.2); }
@media (max-width: 350px) { .member-card { padding-left: 34rpx; padding-right: 34rpx; } .card-brand { font-size: 13rpx; margin-left: 12rpx; letter-spacing: 1rpx; } .card-amount { font-size: 50rpx; } .card-name { font-size: 43rpx; } }
.section-head { display: flex; justify-content: space-between; margin: 58rpx 0 8rpx; font-size: 31rpx; }
.section-hint { color: #666; font-size: 22rpx; }
.transaction { border-bottom: 1rpx solid #e2e2e2; }
.transaction-head { width: 100%; min-height: 130rpx; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 20rpx; padding: 8rpx 0; text-align: left; transition: background-color .18s ease-out, transform .18s ease-out; }
.transaction-head-pressed { background: #f2f2f2; transform: scale(.99); }
.transaction-title, .transaction-time { display: block; }
.transaction-title { font-size: 28rpx; }
.transaction-time { margin-top: 8rpx; color: #666; font-size: 22rpx; }
.transaction-amount { display: flex; align-items: center; gap: 18rpx; font-family: "Times New Roman", serif; font-size: 33rpx; }
.transaction-amount.positive { color: #444; }
.arrow { color: #aaa; font-size: 36rpx; transition: transform .2s ease-out; }
.arrow.open { transform: rotate(90deg); }
.transaction-detail { padding: 0 0 28rpx; color: #666; font-size: 23rpx; line-height: 1.9; white-space: pre-line; }
.member-note { display: flex; flex-direction: column; gap: 18rpx; padding: 42rpx 0; color: #666; font-size: 24rpx; }
.note-copy { color: #444; line-height: 1.8; }
